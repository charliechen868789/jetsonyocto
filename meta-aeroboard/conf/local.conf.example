# -----------------------------
# Machine
# -----------------------------
MACHINE ?= "aeroboard"

# -----------------------------
# Distribution
# -----------------------------
DISTRO ?= "poky"

# -----------------------------
# Package format
# -----------------------------
PACKAGE_CLASSES ?= "package_rpm"

# -----------------------------
# Image features
# -----------------------------
EXTRA_IMAGE_FEATURES ?= "debug-tweaks"

# -----------------------------
# Disk monitoring
# -----------------------------
BB_DISKMON_DIRS ??= "\
    STOPTASKS,${TMPDIR},1G,100K \
    STOPTASKS,${DL_DIR},1G,100K \
    STOPTASKS,${SSTATE_DIR},1G,100K \
    STOPTASKS,/tmp,100M,100K \
    ABORT,${TMPDIR},100M,1K \
    ABORT,${DL_DIR},100M,1K \
    ABORT,${SSTATE_DIR},100M,1K \
    ABORT,/tmp,10M,1K"

# -----------------------------
# Image output
# -----------------------------
IMAGE_FSTYPES += " wic wic.bz2"
IMAGE_FSTYPES_remove_pn-tegra-minimal-initramfs = "wic wic.bz2"

WKS_FILE = "aeroboard-sd.wks"
WKS_FILE_PATH =. "${TOPDIR}/wic:"

IMAGE_BOOT_FILES = "Image \
    tegra210-p3448-0003-p3542-0000.dtb \
    extlinux.conf;extlinux/extlinux.conf \
"

# -----------------------------
# Graphics / Qt
# -----------------------------
DISTRO_FEATURES:append = " opengl"

PACKAGECONFIG:append:pn-qtbase = " gles2 eglfs kms gbm"
PACKAGECONFIG:append:pn-opencv = " dnn python3 gstreamer"
PACKAGECONFIG:pn-qtwayland = "wayland egl"

PREFERRED_PROVIDER_virtual/egl = "tegra-libraries-eglcore"
PREFERRED_PROVIDER_virtual/libgles2 = "tegra-libraries-glescore"
PREFERRED_PROVIDER_virtual/libgl = "tegra-libraries-glxcore"

LICENSE_FLAGS_WHITELIST = "commercial"

# OpenCV CUDA disabled (GCC incompatibility)
PACKAGECONFIG:remove:pn-opencv = "cuda cudnn"

# -----------------------------
# Image packages
# -----------------------------
IMAGE_INSTALL:append = " \
    gui-app \
    qtbase \
    qtdeclarative \
    qtquickcontrols2 \
    qtquickcontrols2-qmlplugins \
"

# -----------------------------
# SDK Features
# -----------------------------
SDKIMAGE_FEATURES = "dev-pkgs dbg-pkgs tools-sdk"

# -----------------------------
# TOOLCHAIN (CRITICAL FIX)
# -----------------------------
TOOLCHAIN_HOST_TASK:append = " \
    nativesdk-packagegroup-sdk-host \
    nativesdk-cmake \
    nativesdk-qttools-tools \
"

TOOLCHAIN_TARGET_TASK:append = " \
    packagegroup-qt5-toolchain-target \
    qtbase-dev \
    qtbase-mkspecs \
    qtbase-staticdev \
    qtdeclarative-dev \
    qtquickcontrols2-dev \
    qtwayland-dev \
    protobuf-dev \
    libevent-dev \
"

# -----------------------------
# QEMU (optional)
# -----------------------------
PACKAGECONFIG:append:pn-qemu-system-native = " sdl"

# -----------------------------
# Misc
# -----------------------------
PATCHRESOLVE = "noop"
CONF_VERSION = "1"